# ─── API Keys ────────────────────────────────────────────────
# Google Gemini API Key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-gemini-api-key-here

# Tavily Search Key from: https://app.tavily.com/home
TAVILY_API_KEY=tvly-your-tavily-key-here

# ─── Model Configuration (Optional) ──────────────────────────
# Active models: gemini-3.5-flash (default), gemini-3.5-flash-lite, gemini-3.8-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-3.5-flash

# ─── Fetch.ai Agentverse Integration ──────────────────────────
# Copy AGENTVERSE KEY from Agentverse Connect
AGENTVERSE_KEY=your_agentverse_api_key_here

# Secret seed phrase for your agent (12-word phrase or any unique secret string)
AGENT_SEED_PHRASE=your-unique-secret-agent-seed-phrase

# Agent details (must match Agentverse registration)
AGENT_NAME="your researcher dost"
AGENT_ENDPOINT="https://fetch1-agents.onrender.com"


